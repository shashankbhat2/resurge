rules_version = '2';

// Rules for the `resurge` named database only. Other apps in this Firebase project
// use their own databases/rules and are not affected by this file.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields the client may write on its own profile document.
    function validProfile() {
      let allowed = ['displayName', 'email', 'photoUrl', 'goals', 'targets',
                     'onboardingComplete', 'onboardedAt', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowed)
        && (!('goals' in request.resource.data) || request.resource.data.goals is list)
        && (!('targets' in request.resource.data) || (
              request.resource.data.targets.calories is int
              && request.resource.data.targets.calories >= 800
              && request.resource.data.targets.calories <= 6000
              && request.resource.data.targets.waterMl is int
              && request.resource.data.targets.waterMl >= 500
              && request.resource.data.targets.waterMl <= 8000))
        && (!('onboardingComplete' in request.resource.data)
              || request.resource.data.onboardingComplete is bool);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false; // account deletion goes through a Cloud Function (Phase 6)

      // Server-owned collections: readable by the owner, written only by Cloud Functions.
      match /usage/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /insights/{doc} { allow read: if isOwner(uid); allow write: if false; }

      // Everything else under the user (meals, water, summaries, coach threads) — owner only.
      // Tightened per collection as each phase lands.
      match /{collection}/{doc=**} {
        allow read, write: if isOwner(uid)
          && !(collection in ['usage', 'insights']);
      }
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

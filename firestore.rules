rules_version = '2';

// Rules for the `resurge` named database only. Other apps in this Firebase project
// use their own databases/rules and are not affected by this file.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields the client may write on its own profile document.
    function validProfile() {
      let allowed = ['displayName', 'email', 'photoUrl', 'goals', 'targets',
                     'onboardingComplete', 'onboardedAt', 'updatedAt', 'timezone',
                     'habitResetTime', 'habitReminder', 'coachStyle', 'units', 'mealReminders'];
      return request.resource.data.keys().hasOnly(allowed)
        && (!('goals' in request.resource.data) || request.resource.data.goals is list)
        && (!('timezone' in request.resource.data) || (request.resource.data.timezone is string
              && request.resource.data.timezone.size() < 64))
        && (!('targets' in request.resource.data) || (
              request.resource.data.targets.calories is int
              && request.resource.data.targets.calories >= 800
              && request.resource.data.targets.calories <= 6000
              && request.resource.data.targets.waterMl is int
              && request.resource.data.targets.waterMl >= 500
              && request.resource.data.targets.waterMl <= 8000))
        && (!('onboardingComplete' in request.resource.data)
              || request.resource.data.onboardingComplete is bool)
        && (!('coachStyle' in request.resource.data) || request.resource.data.coachStyle in ['friend', 'commander'])
        && (!('habitResetTime' in request.resource.data) || isClock(request.resource.data.habitResetTime))
        && (!('habitReminder' in request.resource.data) || (
              request.resource.data.habitReminder.keys().hasOnly(['enabled', 'time'])
              && request.resource.data.habitReminder.enabled is bool
              && isClock(request.resource.data.habitReminder.time)))
        && (!('units' in request.resource.data) || request.resource.data.units in ['metric', 'imperial'])
        && (!('mealReminders' in request.resource.data) || (
              request.resource.data.mealReminders.keys().hasOnly(['breakfast', 'lunch', 'dinner'])
              && validReminderTimes(request.resource.data.mealReminders)));
    }

    function validReminderTimes(m) {
      return (!('breakfast' in m) || m.breakfast == 'off' || isClock(m.breakfast))
        && (!('lunch' in m) || m.lunch == 'off' || isClock(m.lunch))
        && (!('dinner' in m) || m.dinner == 'off' || isClock(m.dinner));
    }

    function isDay(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A manual workout, or edits to / removal of a Health Connect session (id = its record id).
    function validWorkout() {
      let w = request.resource.data;
      return w.keys().hasOnly(['source', 'activityId', 'title', 'startMs', 'endMs', 'localDate',
                               'metrics', 'notes', 'deleted', 'updatedAt'])
        && w.source in ['manual', 'health_connect']
        && w.activityId is string && w.activityId.size() <= 40
        && (w.title == null || (w.title is string && w.title.size() <= 80))
        && w.startMs is int && w.endMs is int && w.endMs > w.startMs
        && w.endMs - w.startMs <= 86400000
        && isDay(w.localDate)
        && w.metrics is map && w.metrics.size() <= 12
        && (!('exercises' in w.metrics) || (w.metrics.exercises is list && w.metrics.exercises.size() <= 30))
        && (w.notes == null || (w.notes is string && w.notes.size() <= 500))
        && w.deleted is bool;
    }

    // A logged meal. Item nutrition is per 100 g; thumb is a small JPEG.
    function validMeal() {
      let m = request.resource.data;
      return m.keys().hasOnly(['type', 'loggedAtMs', 'localDate', 'source', 'title', 'items',
                               'thumb', 'aiTotals', 'updatedAt'])
        && m.type in ['breakfast', 'lunch', 'dinner', 'snack']
        && m.loggedAtMs is int
        && isDay(m.localDate)
        && m.source in ['scan', 'text', 'manual']
        && m.title is string && m.title.size() > 0 && m.title.size() <= 80
        && m.items is list && m.items.size() <= 20
        && (!('thumb' in m) || (m.thumb is bytes && m.thumb.size() <= 120000))
        && (!('aiTotals' in m) || (m.aiTotals is map && m.aiTotals.size() <= 6));
    }

    // A weigh-in: manual, or imported from Health Connect (id "hc_<record id>"). Stored in kg.
    function validWeighIn() {
      let w = request.resource.data;
      return w.keys().hasOnly(['kg', 'atMs', 'localDate', 'note', 'source', 'hcId', 'updatedAt'])
        && w.kg is number && w.kg >= 20 && w.kg <= 400
        && w.atMs is int
        && isDay(w.localDate)
        && (!('note' in w) || w.note == null || (w.note is string && w.note.size() <= 120))
        && (!('source' in w) || w.source in ['manual', 'health_connect'])
        && (!('hcId' in w) || (w.hcId is string && w.hcId.size() <= 200));
    }

    function validWeightGoal() {
      let g = request.resource.data;
      return g.keys().hasOnly(['startKg', 'startDate', 'goalKg', 'paceKgPerWeek', 'mode', 'milestonesCelebrated',
                               'reachedOn', 'updatedAt'])
        && (!('mode' in g) || g.mode in ['change', 'maintain'])
        && (!('milestonesCelebrated' in g) || (g.milestonesCelebrated is int && g.milestonesCelebrated >= 0 && g.milestonesCelebrated <= 200))
        && (!('reachedOn' in g) || g.reachedOn == null || isDay(g.reachedOn))
        && g.startKg is number && g.startKg >= 20 && g.startKg <= 400
        && g.goalKg is number && g.goalKg >= 20 && g.goalKg <= 400
        && isDay(g.startDate)
        && g.paceKgPerWeek is number && g.paceKgPerWeek > 0 && g.paceKgPerWeek <= 2;
    }

    // A progress photo's metadata. The photo itself is end-to-end encrypted in Storage.
    function validProgressPhoto() {
      let p = request.resource.data;
      return p.keys().hasOnly(['takenAtMs', 'localDate', 'pose', 'width', 'height', 'uploaded', 'updatedAt'])
        && p.takenAtMs is int
        && isDay(p.localDate)
        && (!('pose' in p) || p.pose is string) // written by early builds only
        && p.width is int && p.width > 0 && p.width <= 4000
        && p.height is int && p.height > 0 && p.height <= 4000
        && p.uploaded is bool;
    }

    // The photo key, wrapped by a restore secret that only the user's phones hold (in Block Store), so
    // the server can't unwrap it. Never swapped in place: starting fresh deletes it and makes a new one.
    function validProgressKey() {
      let k = request.resource.data;
      return k.keys().hasOnly(['wrapped', 'keyId', 'version', 'createdAt', 'updatedAt'])
        && k.wrapped is bytes && k.wrapped.size() <= 4096
        && k.keyId is int
        && k.version is int;
    }

    // A made progress reel: which photos it plays (ids only), written by the phone's daily check.
    function validProgressReel() {
      let r = request.resource.data;
      return r.keys().hasOnly(['kind', 'createdAtMs', 'from', 'to', 'pose', 'frameIds', 'newFrames',
                               'milestoneKg', 'watched', 'updatedAt'])
        && r.kind in ['regular', 'milestone', 'goal']
        && r.createdAtMs is int
        && isDay(r.from) && isDay(r.to)
        && (!('pose' in r) || r.pose is string) // written by early builds only
        && r.frameIds is list && r.frameIds.size() <= 12
        && r.newFrames is int
        && (!('milestoneKg' in r) || r.milestoneKg is number)
        && r.watched is bool;
    }

    // Reel schedule: on/off, interval (3 days to 8 weeks) and what's been handled.
    function validProgressSettings() {
      let p = request.resource.data;
      return p.keys().hasOnly(['reelsEnabled', 'intervalDays', 'lastDue', 'lastMilestoneKg', 'goalReelFor', 'updatedAt'])
        && (!('reelsEnabled' in p) || p.reelsEnabled is bool)
        && (!('intervalDays' in p) || p.intervalDays in [3, 5, 7, 14, 21, 28, 42, 56])
        && (!('lastDue' in p) || isDay(p.lastDue))
        && (!('lastMilestoneKg' in p) || p.lastMilestoneKg is number)
        && (!('goalReelFor' in p) || isDay(p.goalReelFor));
    }

    function validWaterDay(date) {
      let d = request.resource.data;
      return isDay(date)
        && d.keys().hasOnly(['date', 'ml', 'updatedAt'])
        && d.date == date
        && d.ml is int && d.ml >= 0 && d.ml <= 20000;
    }

    function isClock(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validHabit() {
      let h = request.resource.data;
      return h.keys().hasOnly(['name', 'icon', 'color', 'order', 'archived', 'createdDate',
                               'currentStreak', 'bestStreak', 'createdAt', 'updatedAt'])
        && h.name is string && h.name.size() > 0 && h.name.size() <= 60
        && h.icon is string && h.icon.size() <= 32
        && h.color is string && h.color.size() <= 32
        && h.order is int && h.archived is bool
        && h.createdDate is string && h.createdDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('currentStreak' in h) || h.currentStreak is int)
        && (!('bestStreak' in h) || h.bestStreak is int);
    }

    // Check-ins may only be written for habit days close to now (today / yesterday's grace,
    // with slack for timezones and reset times): from 3 days ago to 2 days ahead.
    function validHabitDay(date) {
      let d = request.resource.data;
      let parts = date.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['date', 'entries', 'updatedAt'])
        && d.date == date
        && d.entries is map && d.entries.size() <= 40
        && d.entries.values().hasOnly(['done', 'missed'])
        && day > request.time - duration.value(3, 'd')
        && day < request.time + duration.value(2, 'd');
    }

    // A finished workout / night of sleep posted by the app. Create-only: the analyzeEvent
    // function fires once per new document and owns all later updates (status, insightId).
    function validEvent(eventId) {
      let e = request.resource.data;
      return e.keys().hasOnly(['type', 'hcId', 'startMs', 'endMs', 'timezone', 'localDate',
                               'workout', 'sleep', 'source', 'status', 'createdAt'])
        && e.type in ['workout', 'sleep']
        && e.hcId is string && e.hcId == eventId
        && e.startMs is int && e.endMs is int && e.endMs > e.startMs
        && e.timezone is string && e.localDate is string
        && e.status == 'pending';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false; // account deletion goes through a Cloud Function (Phase 6)

      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validEvent(eventId);
        allow update, delete: if false;
      }

      match /habits/{habitId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validHabit();
        allow delete: if false; // habits are archived, never deleted, so history stays intact
      }

      match /habitDays/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validHabitDay(date);
        allow delete: if false;
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWorkout();
      }

      match /meals/{mealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMeal();
      }

      match /waterDays/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWaterDay(date);
        allow delete: if false;
      }

      match /weights/{weightId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWeighIn();
      }

      match /weightGoal/{doc} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && doc == 'current' && validWeightGoal();
      }

      match /progressPhotos/{photoId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgressPhoto();
      }

      match /progressKey/{doc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && doc == 'current' && validProgressKey();
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /progressReels/{reelId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgressReel();
      }

      match /progressSettings/{doc} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && doc == 'current' && validProgressSettings();
        allow delete: if false;
      }

      // FCM registration tokens (doc id = token).
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt']);
      }

      // Written by Cloud Functions (Admin SDK); the owner can read, and can only mark one seen.
      match /insights/{doc} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt'])
          && request.resource.data.seen is bool;
      }
      match /usage/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /coachThreads/{threadId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /turns/{turnId} { allow read: if isOwner(uid); allow write: if false; }
      }

      // Everything else under the user (daily summaries) — owner only.
      match /{collection}/{doc=**} {
        allow read, write: if isOwner(uid)
          && !(collection in ['events', 'devices', 'insights', 'usage', 'coachThreads', 'habits', 'habitDays',
                              'workouts', 'meals', 'waterDays', 'weights', 'weightGoal',
                              'progressPhotos', 'progressKey', 'progressReels', 'progressSettings']);
      }
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

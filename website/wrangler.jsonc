// The site as a Cloudflare Worker serving static assets on resurge.fit. `npm run deploy` builds and
// publishes it.
{
  "name": "resurge-website",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "resurge.fit", "custom_domain": true }]
}

// The site as a Cloudflare Worker on resurge.fit: static assets, plus the waitlist endpoint in
// worker/index.ts. `npm run deploy` builds and publishes it.
{
  "name": "resurge-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the API runs the Worker; every page and file is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Waitlist sign-ups are emailed here. Needs Email Routing on resurge.fit with this address verified.
  "send_email": [{ "name": "WAITLIST_MAIL", "destination_address": "shashankbhatme@gmail.com" }],
  "routes": [{ "pattern": "resurge.fit", "custom_domain": true }]
}

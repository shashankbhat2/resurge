---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="mx-auto max-w-[1200px] px-6 pt-48 text-center">
    <p class="reveal text-[13px] tracking-[0.08em] text-accent uppercase">404</p>
    <h1 class="reveal headline mt-[18px] text-[clamp(44px,6.4vw,92px)]" style="--d:1">Nothing here.<br /><span class="text-dim">Let's get you back.</span></h1>
    <div class="reveal mt-9 flex flex-wrap justify-center gap-3" style="--d:2">
      <a href="/" class="inline-flex h-14 items-center rounded-full bg-white px-7 font-semibold text-black transition-transform hover:scale-[1.03]">Home</a>
      <a href="/download" class="inline-flex h-14 items-center rounded-full bg-white/[0.06] px-6 font-medium transition-colors hover:bg-white/[0.12]">Download</a>
    </div>
  </section>
</Base>

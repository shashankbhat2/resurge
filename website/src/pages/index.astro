---
import Base from '../layouts/Base.astro';
import { app, faqPage } from '../lib/seo';
import Phone from '../components/Phone.astro';
import Ring from '../components/Ring.astro';
import TodayScreen from '../components/TodayScreen.astro';
import ScoreStory from '../components/ScoreStory.astro';
import Faq from '../components/Faq.astro';
import MainFeatures from '../components/MainFeatures.astro';
import BentoTile from '../components/BentoTile.astro';
import { REPO } from '../lib/site';

const partners = ['Fitbit', 'Pixel Watch', 'Samsung Health', 'Garmin', 'Oura', 'Withings'];
---

<Base title="Resurge" schema={[await app(Astro.site!), faqPage(Astro.site!)]}>
  <!-- Hero -->
  <section class="relative mx-auto max-w-[1200px] px-6 pt-40 text-center">
    <div class="glow pointer-events-none absolute top-16 left-1/2 h-[600px] w-[min(900px,100vw)] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(139,124,255,0.1),transparent)]" aria-hidden="true"></div>
    <div class="reveal relative inline-flex h-8 items-center gap-2 rounded-full border border-[#2A2A2A] px-3.5 text-[13px] text-muted">
      <span class="size-1.5 rounded-full bg-up"></span>
      Try for free · Android
    </div>
    <h1 class="reveal headline relative mx-auto mt-7 max-w-[940px] text-[clamp(48px,7.4vw,104px)] leading-[0.98]" style="--d:1">
      Your whole day.<br /><span class="text-dim">One calm coach.</span>
    </h1>
    <p class="reveal relative mx-auto mt-7 max-w-[560px] text-[19px] leading-relaxed text-muted" style="--d:2">
      Sleep, steps, workouts, meals and habits in one place, scored every morning, with a coach that has actually read them.
    </p>
    <div class="reveal relative mt-9 flex flex-wrap justify-center gap-3" style="--d:3">
      <a href="/download" class="inline-flex h-14 items-center gap-2.5 rounded-full bg-white px-7 font-semibold text-black transition-transform hover:scale-[1.03] active:scale-[0.98]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M5 20h14" /></svg>
        Try for free
      </a>
      <a href={REPO} class="inline-flex h-14 items-center gap-2.5 rounded-full bg-white/[0.06] px-6 font-medium transition-colors hover:bg-white/[0.12]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
        Star on GitHub
      </a>
    </div>
    <p class="reveal relative mt-4 text-[13px] text-subtle" style="--d:4">Android 8.0 or later · Works with Health Connect · GPL-3.0</p>

    <!-- The phone, with cards floating either side -->
    <div class="relative mt-[72px] grid items-center gap-8 text-left lg:grid-cols-[1fr_300px_1fr]">
      <div class="hidden flex-col items-end gap-4 lg:flex">
        <div class="reveal float flex w-[250px] items-center gap-3.5 rounded-[20px] border border-line bg-surface p-[18px]" style="--d:3">
          <Ring value={92} kind="recovery" size={56}><span class="text-lg font-semibold">92</span></Ring>
          <div><div class="text-sm font-semibold">Recovery</div><div class="text-[13px] text-recovery">Ready to train</div></div>
        </div>
        <div class="reveal float w-[220px] rounded-[20px] border border-line bg-surface p-[18px]" style="--d:5">
          <div class="text-xs text-subtle">Day streak</div>
          <div class="mt-1.5 font-display text-5xl leading-none font-semibold tracking-[-0.04em]">12</div>
          <div class="mt-3 grid grid-cols-7 gap-1">
            {['up', 'up', 'mid', 'up', 'up', 'up', 'today'].map((s) => (
              <span class:list={['aspect-square rounded', s === 'up' && 'bg-up', s === 'mid' && 'bg-[rgba(255,198,26,0.35)]', s === 'today' && 'border-[1.5px] border-accent']} />
            ))}
          </div>
        </div>
      </div>

      <div class="reveal justify-self-center" style="--d:2">
        <Phone class="shadow-[0_40px_120px_rgba(139,124,255,0.08)]">
          <TodayScreen />
        </Phone>
      </div>

      <div class="hidden flex-col items-start gap-4 lg:flex">
        <div class="reveal float w-[260px] rounded-[20px] border border-line bg-surface p-4" style="--d:4">
          <div class="flex items-center gap-2">
            <span class="flex size-[22px] items-center justify-center rounded-full bg-white text-black">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.2 6.3 6.3 2.2-6.3 2.2L12 19.5l-2.2-6.3L3.5 11l6.3-2.2z" /></svg>
            </span>
            <span class="text-xs text-subtle">After your run</span>
          </div>
          <p class="mt-2.5 text-sm leading-normal text-[#D4D4D4]">10.2 km at an easy 148 bpm. That's your longest run this month, on a good night's sleep.</p>
        </div>
        <div class="reveal float flex w-[230px] items-center gap-3 rounded-[20px] border border-line bg-surface p-4" style="--d:6">
          <span class="flex size-10 items-center justify-center rounded-xl bg-surface-2 text-muted">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5" /><circle cx="7" cy="11" r="1.6" /></svg>
          </span>
          <div><div class="text-sm font-semibold">7h 12m asleep</div><div class="text-xs text-subtle">1h 42m deep</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Works with -->
  <section class="reveal mx-auto max-w-[1200px] px-6 pt-24">
    <p class="text-center text-[13px] tracking-[0.08em] text-subtle uppercase">Works with what you already wear, through Health Connect</p>
    <ul class="mx-auto mt-6 grid max-w-[760px] grid-cols-2 gap-px overflow-hidden rounded-[28px] border border-line bg-line">
      {
        partners.map((p) => (
          <li class="flex h-24 items-center justify-center bg-surface font-display text-[22px] font-semibold tracking-[-0.02em] text-muted transition-colors duration-500 hover:bg-[#101010] hover:text-white">
            {p}
          </li>
        ))
      }
    </ul>
  </section>

  <MainFeatures />

  <ScoreStory />

  <!-- Bento: everything else, each with a real piece of the app -->
  <section id="features" class="mx-auto max-w-[1200px] scroll-mt-24 px-6 pt-40">
    <h2 class="reveal headline max-w-[760px] text-[clamp(40px,5.2vw,72px)]">Everything in one day.<br /><span class="text-dim">Nothing counted twice.</span></h2>
    <div class="reveal mt-14 grid gap-px overflow-hidden rounded-[28px] border border-line bg-line md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-[340px_340px_340px_auto]">
      <BentoTile wide label="Habits" color="#22F5C3" title="Streaks that forgive." body="One tap a day. Miss one and a freeze covers it, so a single off day never wipes out a month." img="/ui/habits.webp" alt="Two habits with their week of check-ins and streaks." />
      <BentoTile label="Strength" color="#FF7A2E" title="Log sets in a tap." img="/ui/strength.webp" alt="The strength logger with sets of front squats checked off." />
      <BentoTile label="Workouts" color="#FF7A2E" title="Every workout counts, once." body="From your watch, merged when two apps saw the same one." img="/ui/workout.webp" alt="A 5.24 km run from Pixel Watch, with pace and heart rate." />
      <BentoTile wide label="Sleep" color="#97A2F5" title="Every stage of the night." body="Time asleep, quality and stages, from whatever you sleep with." img="/ui/sleep.webp" alt="Last night's sleep stages, 6h 15m asleep at 96% quality." />
      <BentoTile label="Weight" color="#5CC8F2" title="Your trend, not the scale." img="/ui/weight.webp" alt="A weight trend of 78.6 kg, down 1.1 kg, with a month chart." />
      <BentoTile label="Weekly review" color="#8B7CFF" title="A Saturday read on your week." img="/ui/weekly.webp" alt="A weekly review: a steadier week with more sleep and four active days." />
      <BentoTile label="Smart scale" color="#5CC8F2" title="Just step on." img="/ui/scale.webp" alt="Smart scale settings: listening, with a Weigh in now button." />
      <BentoTile label="Your coach" color="#8B7CFF" title="Pick how it talks to you.">
        <div class="mt-4 flex flex-wrap gap-2 text-[13px]">
          <span class="rounded-full bg-surface-2 px-3 py-1.5"><b class="font-semibold">Friend</b> <span class="text-subtle">· warm and patient</span></span>
          <span class="rounded-full bg-surface-2 px-3 py-1.5"><b class="font-semibold">Commander</b> <span class="text-subtle">· direct</span></span>
        </div>
      </BentoTile>
      <BentoTile wide label="Private by design" color="#A3A3A3" title="Your data stays yours.">
        <ul class="mt-4 flex flex-wrap gap-2 text-[13px] text-muted">
          <li class="rounded-full bg-surface-2 px-3 py-1.5">Per-user security rules</li>
          <li class="rounded-full bg-surface-2 px-3 py-1.5">No keys in the app</li>
          <li class="rounded-full bg-surface-2 px-3 py-1.5">Meal photos kept as thumbnails</li>
          <li class="rounded-full bg-surface-2 px-3 py-1.5">Progress photos end-to-end encrypted</li>
        </ul>
      </BentoTile>
    </div>
  </section>

  <!-- Open source, in a line -->
  <p class="reveal mx-auto max-w-[1200px] px-6 pt-24 text-center text-[15px] text-subtle">
    Resurge is open source under the GPL-3.0. <a href={REPO} class="text-accent-soft transition-colors hover:text-white">View the source →</a>
  </p>

  <Faq />

</Base>

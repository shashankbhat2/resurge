---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import { breadcrumbs } from '../lib/seo';
import { REPO } from '../lib/site';

const beliefs = [
  ['Calm over noise.', 'Three scores and one note in the morning, not forty charts. Streaks forgive an off day, so one bad Tuesday never wipes out a month.'],
  ['Honest numbers.', "Scores are measured against your own normal, and say when they're still learning it. Weight is a trend, not a verdict. Every number shows what went into it."],
  ['Open by default.', 'The whole app and its backend are GPL-3.0. You can read how a score is worked out, run your own server, and keep your improvements open for everyone.'],
  ['Your data stays yours.', 'Per-user security rules, no API keys in the app, meal photos kept only as a thumbnail, and progress photos end-to-end encrypted.'],
];

const stack = [
  ['The app', 'Kotlin and Jetpack Compose, Hilt, Firestore with an offline cache, WorkManager, and screenshot-tested UI.'],
  ['Your health data', 'Read through Health Connect, so Fitbit, Pixel Watch, Samsung Health and Garmin all work. Scores are worked out on your phone.'],
  ['The coach', "Firebase Cloud Functions that call Claude with your day's numbers. No keys in the app; deploy your own if you'd rather."],
];
---

<Base title="Story" description="Why Resurge exists, what it believes, and how it's built: an AI health coach for Android, built in the open." schema={[breadcrumbs(Astro.site!, 'Story', '/story')]}>
  <section class="mx-auto max-w-5xl px-6 pt-28">
    <p class="reveal font-secondary text-[12px] tracking-[0.14em] text-subtle uppercase">Story</p>
    <h1 class="reveal headline mt-5 max-w-[760px] text-[clamp(40px,5vw,64px)]" style="--d:1">Health apps count.<br /><span class="text-dim">Resurge reads.</span></h1>
    <p class="reveal mt-7 max-w-[600px] text-[18px] leading-relaxed text-muted" style="--d:2">
      Your phone and watch already know how you slept, how far you walked and how hard you trained. What's usually missing is someone who looks at all of it together and tells you, plainly, what to do today. That's the job Resurge does.
    </p>
  </section>

  <Divider class="mt-24" />

  <section class="mx-auto grid max-w-5xl gap-12 px-6 pt-24 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:gap-16">
    <h2 class="reveal headline text-[clamp(32px,3.4vw,46px)] leading-[1.02]">What we<br /><span class="text-dim">believe.</span></h2>
    <div class="flex flex-col border-b border-white/[0.08]">
      {
        beliefs.map(([title, body], i) => (
          <div class="reveal grid grid-cols-[40px_minmax(0,1fr)] gap-4 border-t border-white/[0.08] py-6" style={`--d:${i}`}>
            <span class="font-secondary text-[13px] tracking-[0.08em] text-faint tabular-nums">0{i + 1}</span>
            <div>
              <h3 class="text-[20px] font-semibold tracking-[-0.01em]">{title}</h3>
              <p class="mt-2 font-secondary text-[15px] leading-relaxed text-muted">{body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Divider class="mt-24" />

  <section class="pt-24">
    <h2 class="reveal headline mx-auto max-w-5xl px-6 text-[clamp(32px,3.4vw,46px)] leading-[1.02]">How it's built.</h2>
    <div class="reveal rail mt-10 grid gap-px border-y border-white/[0.08] bg-white/[0.08] md:grid-cols-3">
      {
        stack.map(([title, body]) => (
          <div class="bg-black p-7 transition-colors duration-500 hover:bg-[#060606]">
            <span class="font-secondary text-[11px] tracking-[0.14em] text-subtle uppercase">{title}</span>
            <p class="mt-3.5 font-secondary text-[15px] leading-relaxed text-muted">{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Divider class="mt-24" />

  <section class="reveal mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-8 px-6 pt-24">
    <div class="max-w-[560px]">
      <h2 class="headline text-[clamp(30px,3.2vw,42px)] leading-[1.04]">Built in the open.</h2>
      <p class="mt-4 font-secondary text-[15px] leading-relaxed text-muted">Resurge is made by Shashank Bhat, with every change on GitHub. Ideas, bug reports and pull requests are all welcome.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={REPO} class="inline-flex h-12 items-center rounded-full bg-white px-6 text-[15px] font-semibold text-black transition-transform hover:scale-[1.03]">View on GitHub</a>
      <a href={`${REPO}/issues`} class="inline-flex h-12 items-center rounded-full border border-white/[0.14] px-6 text-[15px] font-medium transition-colors hover:border-white/30 hover:bg-white/[0.06]">Report an issue</a>
    </div>
  </section>
</Base>

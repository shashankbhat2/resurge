---
/** A plain phone frame; the screen is the slot. */
interface Props {
  width?: number;
  height?: number;
  class?: string;
}
const { width = 300, height = 620, class: className = '' } = Astro.props;
---

<div
  class:list={['rounded-[48px] border border-[#2A2A2A] bg-[#1A1A1A] p-2.5', className]}
  style={`width:${width}px;height:${height}px`}
>
  <div class="relative h-full w-full overflow-hidden rounded-[39px] bg-black">
    <slot />
  </div>
</div>

---
import Logo from './Logo.astro';
import { NAV } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!-- A compact glass pill floating over the top of the page. -->
<header class="pointer-events-none fixed inset-x-0 top-5 z-50 flex justify-center px-4">
  <nav
    aria-label="Main"
    class="pointer-events-auto flex h-14 items-center gap-6 rounded-full border border-white/[0.06] bg-[#141414]/60 py-2 pr-2 pl-5 shadow-[0_8px_32px_rgba(0,0,0,0.35)] backdrop-blur-xl"
  >
    <a href="/" class="flex items-center gap-2 font-display text-lg leading-none font-semibold tracking-[-0.02em]">
      <Logo mark size={18} />
      Resurge
    </a>
    <div class="hidden items-center gap-5 text-sm md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['transition-colors hover:text-white', path === item.href ? 'text-white' : 'text-white/70']}
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <a
      href="/download"
      class="inline-flex h-10 items-center rounded-full bg-white/12 px-5 text-[15px] font-medium text-white transition-colors hover:bg-white/20"
    >
      Download
    </a>
  </nav>
</header>

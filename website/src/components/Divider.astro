---
/**
 * A hairline across the page between sections. Where it crosses the layout's two rails sits the
 * coach's mark, unfilled and quiet: the app's four-point star (ic_coach_star), in outline. `plain`
 * leaves the marks off, for lines that sit close to another.
 */
interface Props {
  plain?: boolean;
  class?: string;
}

const { plain = false, class: className = '' } = Astro.props;
---

<div class:list={['relative z-[5] h-px w-full bg-white/[0.08]', className]} aria-hidden="true">
  <div class="rail absolute inset-y-0 inset-x-0">
    {
      !plain &&
      ['left-0 -translate-x-1/2', 'right-0 translate-x-1/2'].map((side) => (
        <svg class:list={['absolute top-0 size-[14px] -translate-y-1/2', side]} viewBox="0 0 24 24" fill="#000" stroke="rgba(255,255,255,0.35)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <path vector-effect="non-scaling-stroke" d="M12,2.8 C13.1,8.2 15.8,10.9 21.2,12 C15.8,13.1 13.1,15.8 12,21.2 C10.9,15.8 8.2,13.1 2.8,12 C8.2,10.9 10.9,8.2 12,2.8 Z" />
        </svg>
      ))
    }
  </div>
</div>
